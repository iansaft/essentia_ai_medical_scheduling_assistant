## Environment
NODE_ENV=development

## PostgreSQL
PG_CNAME=essentia_ai_assistent_postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DEFAULT_DB=postgres
PG_SUPERUSER=admin
PG_SUPERUSER_PW=CHANGE_PG_SUPERUSER_PW
PG_SUPERUSER_SSL_MODE=disable
PG_SUPERUSER_URI=postgres://${PG_SUPERUSER}:${PG_SUPERUSER_PW}@${PG_HOST}:${PG_PORT}/${PG_DEFAULT_DB}?sslmode=${PG_SUPERUSER_SSL_MODE}
PG_DATA_FOLDER=./.docker/postgres

## Redis
REDIS_IMAGE=redis:8.10.2-alpine3.23
REDIS_CNAME=essentia_ai_assistent_redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb
REDIS_DATA_FOLDER=./.docker/redis

## API
API_CNAME=essentia_ai_assistent_api
API_HOST=0.0.0.0
API_PORT=8000

## API n8n base URL (server-side health; use http://n8n:5678 only inside Docker)
API_N8N_BASE_URL=http://localhost:5678

## API Database
API_DB_HOST=postgres
API_DB_PORT=5432
API_DB_NAME=postgres
API_DB_USER=admin
API_DB_PW=CHANGE_PG_SUPERUSER_PW
API_DB_SSL_MODE=disable

## Database Pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=5

## API Redis
API_REDIS_HOST=redis
API_REDIS_PORT=6379
API_REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
API_REDIS_DB=0
API_REDIS_SOCKET_TIMEOUT=2
API_REDIS_CONNECT_TIMEOUT=2

## Application
BUSINESS_TIMEZONE=America/Sao_Paulo

## API CORS (comma-separated origins allowed by the browser)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

## API Logging (JSON lines on stdout when API_LOG_JSON=true)
API_LOG_LEVEL=INFO
API_LOG_JSON=true

## Golang Migrate
GOLANG_MIGRATE_CNAME=essentia_ai_golang_migrate
GOLANG_MIGRATE_IMAGE=migrate/migrate:v4.20.1
MIGRATIONS_PATH=./db/migrations
SEEDS_PATH=./db/seeds

## n8n
N8N_VERSION=2.39.10
N8N_CNAME=essentia_ai_assistent_n8n
N8N_NODE_ENV=production
N8N_HOST=localhost
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=CHANGE_N8N_ENCRYPTION_KEY
N8N_TIMEZONE=America/Sao_Paulo
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
DB_SQLITE_POOL_SIZE=4
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_DATA_FOLDER=./.docker/n8n

## Web
WEB_CNAME=essentia_ai_assistent_web
WEB_PORT=8080
VITE_API_BASE_URL=http://localhost:8000
VITE_N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook-test/essentia-ia-assistent